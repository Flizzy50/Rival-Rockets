{
  "name": "rival-rockets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.build.json",
    "start": "node dist-server/server/main.js",
    "dev:server": "tsc -p tsconfig.server.build.json && node dist-server/server/main.js --dev",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "express": "5.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "qrcode-generator": "2.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
